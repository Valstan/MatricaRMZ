# Разрешаем запуск install/build-скриптов только для явно перечисленных пакетов.
# Это нужно, чтобы Electron скачал бинарники, а esbuild корректно собрался.
only-built-dependencies[]=electron
only-built-dependencies[]=esbuild
only-built-dependencies[]=better-sqlite3
only-built-dependencies[]=better-sqlite3-multiple-ciphers
only-built-dependencies[]=node-datachannel
only-built-dependencies[]=bufferutil
only-built-dependencies[]=utf-8-validate
only-built-dependencies[]=utp-native

# Версия pnpm держится в engines.pnpm (корневой package.json) и проверяется строго.
# Поле `pnpm.overrides` в package.json читается только до pnpm 11: на 11+ оно молча
# игнорируется, install проходит, а CVE-патчи (path-to-regexp, qs, ws, …) выпадают
# из дерева. Строгий режим превращает тихий бамп в падение на install.
engine-strict=true


