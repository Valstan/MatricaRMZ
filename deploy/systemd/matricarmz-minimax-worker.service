# ШАБЛОН — не копировать в /etc/systemd/system как есть.
# Плейсхолдеры __MATRICA_USER__ / __MATRICA_REPO_DIR__ подставляет deploy/systemd/install-backend.sh
# (сервисный пользователь и клон репо живут на сервере, не в репозитории — AGENTS.md §recon-поверхность).
#
# Воркер MiniMax (промт КАРМАНА #56): поднимает агента MiniMax Code на аккаунте из
# пула «Кармана» и говорит с бэкендом по Anthropic-совместимому `/v1/messages`.
# Слушает только localhost — наружу его выставлять нечего, ходит к нему бэкенд
# на том же боксе (127.0.0.1).
[Unit]
Description=MatricaRMZ MiniMax worker (движок ИИваныча на проде)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=__MATRICA_REPO_DIR__/backend-api
EnvironmentFile=/etc/matricarmz/matricarmz.env
Environment=HOST=127.0.0.1
Environment=MATRICA_MINIMAX_WORKER_PORT=3010
# Роль `worker`: фоновые джобы бэкенда этот юнит НЕ поднимает. Иначе вторая
# обработка очереди ИИваныча — тот же вопрос получит два ответа (services/instanceRole.ts).
Environment=MATRICA_INSTANCE_ROLE=worker
ExecStart=/usr/bin/node __MATRICA_REPO_DIR__/backend-api/dist/minimaxWorker/index.js
Restart=always
RestartSec=5
User=__MATRICA_USER__

[Install]
WantedBy=multi-user.target
