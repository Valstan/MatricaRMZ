# Shell-скрипты должны быть с LF независимо от ОС разработчика —
# bash на проде падает на CRLF в shebang ("/usr/bin/env bash^M: not found").
*.sh text eol=lf

# Drizzle SQL-миграции — тоже LF (на проде sha256-сверка с drizzle.__drizzle_migrations).
*.sql text eol=lf

# Nginx конфиги — LF для совместимости с include на Linux.
deploy/nginx/*.conf text eol=lf

# Systemd-юниты — LF (на проде в /etc/systemd/system/; CRLF ломает парсинг Environment/ExecStart).
deploy/systemd/*.service text eol=lf
deploy/systemd/*.timer text eol=lf

# Инструмент для машин парка — наоборот, строго CRLF: он запускается Windows
# PowerShell 5.1 и cmd.exe. Без правила файлы приедут с LF на любой машине, где
# core.autocrlf выключен (у нас это лишь локальная настройка, не свойство репо).
# Правило узкое — по каталогу, а не по `*.ps1`: остальные девять .ps1 лежат в
# индексе как LF, и глобальное правило переписало бы их все разом.
# `working-tree-encoding` сюда НЕ добавлять: он пересоздаёт файл при каждом
# checkout и убьёт UTF-8 BOM у .ps1, без которого PowerShell 5.1 читает кириллицу
# как cp1251 и не парсит скрипт вовсе (та же поломка, что описана в
# releaseWelcome.ts про логи без BOM).
scripts/client-ops/*.ps1 text eol=crlf
scripts/client-ops/*.cmd text eol=crlf

# Памятка, которую установщик кладёт на Рабочий стол, — её читают в Блокноте на
# машинах парка: строго CRLF, чтобы строки не слиплись. UTF-8 BOM у файла есть и
# должен уцелеть, поэтому `working-tree-encoding` сюда НЕ добавлять (тот же довод,
# что для .ps1 выше: он пересоздаёт файл и убивает BOM).
electron-app/installer/kaspersky-desktop-readme.txt text eol=crlf
