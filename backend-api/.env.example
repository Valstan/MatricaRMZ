# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=matricarmz
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGSSL=false

# Backend listener
HOST=127.0.0.1
PORT=3001
TZ=Europe/Moscow
MATRICA_INSTANCE_ROLE=primary

# Security
MATRICA_JWT_SECRET=CHANGE_ME
# CORS allow-list (CSV). Пусто/* = любой origin. Планшет (Capacitor WebView) шлёт
# capacitor://localhost (или https://localhost при androidScheme=https).
# MATRICA_CORS_ORIGINS=https://a6fd55b8e0ae.vps.myjino.ru,capacitor://localhost,https://localhost

# Runtime directories
MATRICA_LOGS_DIR=backend-api/logs
MATRICA_UPLOADS_DIR=backend-api/uploads
MATRICA_UPDATES_DIR=backend-api/updates
MATRICA_LEDGER_DIR=backend-api/ledger
MATRICA_LEDGER_DATA_KEY=CHANGE_ME_BASE64

# Public URLs and sync
MATRICA_API_URL=https://a6fd55b8e0ae.vps.myjino.ru
MATRICA_PUBLIC_BASE_URL=https://a6fd55b8e0ae.vps.myjino.ru
SYNC_V2_ENFORCE=1
MATRICA_SYNC_AUTOHEAL_ENABLED=1
MATRICA_SYNC_PULL_ADAPTIVE_ENABLED=1

# Update distribution
MATRICA_TORRENT_TRACKER_PORT=6969
MATRICA_TORRENT_TRACKER_URLS=http://127.0.0.1:6969/announce

# AI and reports
AI_PROFILE=balanced
AI_REPORT_ENABLED=false
AI_REPORT_TZ=Europe/Moscow
# Глобальный рубильник AI. Когда false — ни нейрочат, ни аналитика, ни cron-агент
# логов НЕ обращаются к Anthropic API, /health возвращает features.aiEnabled=false,
# UI скрывает кнопку нейрочата.
AI_ENABLED=true

# Движок нейросети (D-024): deepseek (по умолчанию) | anthropic.
# Anthropic режет РФ-IP на эдже, поэтому с прода работает именно deepseek.
MATRICA_AI_PROVIDER=deepseek
# DeepSeek API — ключ берётся из комнаты matricarmz в KARMAN. https://platform.deepseek.com
# Префикс MATRICA_* — основной; DEEPSEEK_API_KEY поддержан как fallback.
MATRICA_AI_DEEPSEEK_API_KEY=
# Claude API (Anthropic) — только для MATRICA_AI_PROVIDER=anthropic.
MATRICA_AI_CLAUDE_API_KEY=
# Опциональные оверрайды моделей (по умолчанию: deepseek-v4-flash для chat, deepseek-v4-pro для analytics)
AI_MODEL_CHAT=
AI_MODEL_ANALYTICS=
# Read-only PG user для сбора корпуса чатов в aiAgentChatLearningService
AI_DB_RO_USER=
AI_DB_RO_PASSWORD=
# Read-only tool use (function calling) — БД-tools для нейрочата и аналитики.
AI_CHAT_TOOLS_ENABLED=true
AI_ANALYTICS_TOOLS_ENABLED=true
# Сколько подряд ответов "не знаю" в чате до автоэскалации flash → pro
AI_CHAT_ESCALATE_AFTER=3

# Прямой движок ИИваныча (asyncChat): период опроса очереди и потолки одного ответа.
AI_CHAT_DIRECT_TICK_MS=2000
AI_CHAT_ANSWER_TIMEOUT_MS=300000
AI_CHAT_ANSWER_MAX_TOKENS=4000
AI_CHAT_ANSWER_MAX_STEPS=8
AI_CHAT_ANSWER_MAX_ATTEMPTS=3

# История нейрочата: автоудаление сообщений старше N дней.
AI_CHAT_HISTORY_RETENTION_DAYS=90
AI_CHAT_HISTORY_CLEANUP_ENABLED=true

# Cron-агент анализа логов (по умолчанию выключен).
AI_LOG_ANALYSIS_ENABLED=false
AI_LOG_ANALYSIS_TIMES=06:00,18:00
AI_LOG_ANALYSIS_TZ=Europe/Moscow
AI_LOG_ANALYSIS_LOOKBACK_HOURS=12

# Integrations
MATRICA_TELEGRAM_BOT_TOKEN=
MATRICA_TELEGRAM_ALERT_CHAT_ID=
MATRICA_TELEGRAM_ALERT_LOGIN=
YANDEX_DISK_TOKEN=
YANDEX_DISK_BASE_PATH=
MATRICA_LEDGER_RELEASE_TOKEN=

# Off-site backup encryption (обязательно на проде).
# Публичный ключ RSA-4096 (PEM). Сервер умеет ТОЛЬКО зашифровать: приватная половина
# хранится вне сервера, поэтому украденный YANDEX_DISK_TOKEN даёт лишь шифротекст.
# Без ключа ночной бэкап останавливается — открытый дамп наружу не уходит.
BACKUP_ENCRYPTION_PUBLIC_KEY_FILE=/opt/matricarmz/secrets/backup-public.pem
# Альтернатива файлу: PEM или base64-от-PEM прямо в переменной.
BACKUP_ENCRYPTION_PUBLIC_KEY=

# Ключ шифрования ночного СНИМКА (`.sqlite.enc`) — 32 байта в base64.
# Снимок читает фича клиента «просмотр бэкапа», поэтому расшифровывать его должен уметь
# сервер: ключ симметричный. Утечка одного YANDEX_DISK_TOKEN перестаёт давать открытый текст;
# от компрометации самого сервера это не защищает и не должно.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Без ключа ночной бэкап останавливается — открытый снимок наружу не уходит.
BACKUP_SNAPSHOT_KEY=
